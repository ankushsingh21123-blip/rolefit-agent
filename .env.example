# Copy to .env and fill in. Never commit a real key.
# Gemini models (defaults work with the free tier).
# Verified live 24 Nov 2026: gemini-3.6-flash generates fine, and
# gemini-embedding-001 embeds fine (3072 dims). text-embedding-004
# returns 404 for this key — do not use it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Store: "memory" (no database, default) or "postgres" (needs DATABASE_URL).
STORE=memory
# Example local Postgres (docker-compose): postgresql://rolefit:rolefit@db:5432/rolefit
DATABASE_URL=
EMBEDDING_DIM=3072
